# Copy to .env for non-secret configuration. Save provider keys from local Setup.
# Clip Desk protects saved credentials under the current Windows user.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Optional private topic on an HTTPS ntfy server. Keep the topic private.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
# Configure hosted and Ollama models in Setup > AI providers.
# Set an AI provider preset or use a custom OpenAI-compatible base URL.
AI_PROVIDER=custom
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Hosted frame review is opt-in. Set a vision model ID and choose remote in Setup to enable.
AI_VISION_MODE=local
AI_VISION_MODEL=
OLLAMA_URL=
# Optional bearer token for an authenticated HTTPS Ollama endpoint. Save it in Setup.
OLLAMA_API_TOKEN=
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_LEARN_MODEL=gemma4:latest
# Optional vision model for the CLI draft writer.
OLLAMA_VISION_MODEL=gemma4:latest
# Optional Umbrel vision model for the selective posting check. Defaults to OLLAMA_VISION_MODEL.
OLLAMA_QUALITY_MODEL=
# Optional local similarity check for rephrased captions. Example: nomic-embed-text:latest
OLLAMA_EMBED_MODEL=
# Local captions (faster-whisper on CPU): tiny / base / small
WHISPER_MODEL=base
# cpu (works now) or auto = try the NVIDIA GPU first (needs nvidia-cublas-cu12 + nvidia-cudnn-cu12, not installed)
WHISPER_DEVICE=cpu
# auto = NVENC (needs NVIDIA driver 610+), then Intel QuickSync, else x264. Or set nvenc / qsv / x264
ENCODER=auto
# Parallel caption+render jobs
RENDER_WORKERS=2
# Render the selected format by default. Other styles are available on demand in Review.
RENDER_ALL_VARIANTS=false
TIKTOK_HANDLE=
# Automatic TikTok publishing. Finish connecting the channel on the local /autopost page.
BUFFER_API_KEY=
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public HTTPS base URL for the dedicated staging bucket. Buffer reads the videos here.
R2_PUBLIC_BASE_URL=
# Optional approved TikTok for Business Discovery access for weekly GTA trend examples.
TIKTOK_DISCOVERY_TOKEN=
TIKTOK_ADVERTISER_ID=
TIKTOK_DISCOVERY_COUNTRY=US
# Optional approved Instagram Public Content Access and YouTube Data API key.
IG_RESEARCH_TOKEN=
IG_RESEARCH_USER_ID=
YT_RESEARCH_KEY=
DAILY_TARGET=10
LANGUAGES=en
PORT=8788
# Watch only creators you add and have permission to clip.
WATCHLIST_ONLY=1
# Whop read-only account discovery. Supply the business account ID and your actual country.
WHOP_API_KEY=
WHOP_ACCOUNT_ID=
WHOP_COUNTRY=
# Whop developer app OAuth settings. Connect the creator user in Clip Desk Setup.
WHOP_CLIENT_ID=
WHOP_CLIENT_SECRET=
# Optional: Kick app keys (dev.kick.com) to list live GTA streams on Kick
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
